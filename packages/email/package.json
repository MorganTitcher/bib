{
  "name": "@bib/email",
  "version": "0.1.0",
  "description": "A provider-agnostic email port with retry, fallback, idempotency and a reusable adapter contract test.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./address": {
      "types": "./dist/address.d.ts",
      "default": "./dist/address.js"
    },
    "./message": {
      "types": "./dist/message.d.ts",
      "default": "./dist/message.js"
    },
